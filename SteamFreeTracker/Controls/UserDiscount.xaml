<UserControl x:Class="SteamFreeTracker.Controls.UserDiscount"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SteamFreeTracker.Controls"
             mc:Ignorable="d" 
             Height="20">
    <StackPanel Orientation="Horizontal" Background="#3F000000">
        <!--打折百分比-->
        <Grid Background="#A1CD44">
            <TextBlock x:Name="textBlock_Percent" Text="-100%" Margin="1,2,1,2" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <!--原价-->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="textBlock_InitalPrice" Text="￥100.00" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="8" Margin="2,0,2,0" Foreground="#FF505050"/>
            
            <!--划线-->
            <Line X1="0" Y1="1" X2="1" Y2="0" Stroke="#FF505050" StrokeThickness="1" Stretch="Fill" Margin="2" Opacity="1"/>
        </Grid>
        <!--最终价-->
        <Grid>
            <TextBlock x:Name="textBlock_FinalPrice" Text="￥0.00" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Margin="2" Foreground="White" FontWeight="Bold"/>
        </Grid>
    </StackPanel>
</UserControl>
