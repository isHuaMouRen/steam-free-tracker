<Application x:Class="SteamFreeTracker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SteamFreeTracker"
             Startup="Application_Startup"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>



        <LinearGradientBrush x:Key="SteamTheme" EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#1B2838" Offset="1"/>
            <GradientStop Color="#111B25" Offset="0"/>
        </LinearGradientBrush>
        
    </Application.Resources>
</Application>
